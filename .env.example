# Copy this file to .env.local and fill in real values.
# Never commit .env, .env.local, or any file containing real keys.

# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Site ──
NEXT_PUBLIC_SITE_URL=

# ── AI chat providers (app/api/agent/chat/route.ts) ──
# All three are optional, but at least one must be set. Tried in order
# (gemini -> openai -> deepseek); if a key is missing or the call fails,
# the next configured provider is used automatically.
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
